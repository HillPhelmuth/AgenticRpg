@using Microsoft.JSInterop
@inject Microsoft.JSInterop.IJSRuntime DraftJs
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider DraftAuth
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <span style="color:white">Hello, @context.User.Identity?.Name!</span>
        <button class="nav-link btn btn-link" @onclick="BeginLogOut">Log out</button>
    </Authorized>
    <NotAuthorized>
        <a href="authentication/login">Log in</a>
    </NotAuthorized>
</AuthorizeView>

@code{
    public async Task BeginLogOut()
    {
        var user = (await DraftAuth.GetAuthenticationStateAsync()).User.Identity?.Name;
        if (user is not null)
        {
            try
            {
                await using var module = await DraftJs.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import", "./_content/AgenticRpg.Components/ChatComponents/draftInput.js");
                await module.InvokeVoidAsync("clearAccount", Uri.EscapeDataString(user));
            }
            catch (Microsoft.JSInterop.JSException) { }
        }
        Navigation.NavigateToLogout("authentication/logout");
    }
    
}
