@using AgenticRpg.Components.ChatComponents
@namespace AgenticRpg.Components.ChatComponents

<div class="user-input @CssClass">
    @if (!string.IsNullOrEmpty(_submissionError)) { <div role="status" aria-live="polite">@_submissionError</div> }
    <div class="input-container">
        @if (_isTextArea)
        {
            <textarea class="input-field @(DraftDisabled ? "disabled" : "")"
                      placeholder="@Placeholder"
                      @bind="_inputValue" @bind:after="PersistDraft"
                      @onkeydown="HandleKeyDown"
                      @bind:event="oninput"
                      rows="@Rows"
                      disabled="@DraftDisabled">
                    </textarea>
        }
        else
        {
            <input class="input-field @(DraftDisabled ? "disabled" : "")"
                   placeholder="@Placeholder"
                   @bind="_inputValue" @bind:after="PersistDraft"
                   @onkeydown="HandleKeyDown"
                   @bind:event="oninput"
                   disabled="@DraftDisabled" />
        }
        <button class="input-toggle-button" @onclick="@(() => _isTextArea = !_isTextArea)">
            @if (_isTextArea)
            {
                <i class="bi bi-arrows-collapse"></i>
            }
            else
            {
                <i class="bi bi-arrows-expand"></i>
            }
        </button>
        <div class="input-actions">
            @if (IsProcessing && OnCancel.HasDelegate)
            {
                <button class="btn-cancel" disabled="@IsUnavailable" @onclick="CancelProcessing">
                    <span class="spinner"></span>
                    Cancel
                </button>
            }
                <button class="btn-submit"
                        @onclick="SubmitMessage"
                        disabled="@(string.IsNullOrWhiteSpace(_inputValue) || IsProcessing || IsUnavailable)">
                    @(IsProcessing ? "Waiting..." : "Send")
                </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(HintText))
    {
        <div class="input-hint">
            @HintText
        </div>
    }
</div>


